# Add to .env.local for development and to the GitHub Actions build variables.
# These are public browser credentials, not secrets. RLS MUST be enabled and tested.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Never put service_role / sb_secret keys or database connection strings in VITE_ variables.
# Do not enable these until the PostgreSQL migration and owner login are verified.
