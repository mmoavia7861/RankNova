rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'moaviah760@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Audits saved by users
    match /audits/{auditId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.url is string && request.resource.data.url.size() <= 1024 &&
        request.resource.data.score is number &&
        isValidId(auditId);
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // SEO Guides & Educational Articles
    match /articles/{articleId} {
      allow get: if resource.data.published == true || isAdmin();
      allow list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // User Feedback and Inquiries
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.email is string &&
        request.resource.data.email.size() <= 256 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 4096;
      allow read, list, update, delete: if isAdmin();
    }

    // Site settings & tool configurations
    match /settings/{settingId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin identities
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
