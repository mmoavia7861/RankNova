rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strict owner-only policy: an arbitrary /admins document cannot grant privileges.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'moaviah760@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Audits saved by users
    match /audits/{auditId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.url is string && request.resource.data.url.size() <= 1024 &&
        request.resource.data.score is number &&
        isValidId(auditId);
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // SEO Guides & Educational Articles
    match /articles/{articleId} {
      allow get: if resource.data.published == true || isAdmin();
      allow list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // User Feedback and Inquiries (client writes remain spam-sensitive; protect with App Check before launch)
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 256 &&
        request.resource.data.email.matches('.*@.*[.].*') &&
        request.resource.data.subject is string && request.resource.data.subject.size() <= 160 &&
        request.resource.data.message is string && request.resource.data.message.size() >= 5 &&
        request.resource.data.message.size() <= 4096 &&
        request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow read, list, update, delete: if isAdmin();
    }

    // Site settings & tool configurations
    match /settings/{settingId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Admin identities
    match /admins/{adminId} {
      allow get, list, write: if false;
    }
  }
}
) &&
        request.resource.data.subject is string && request.resource.data.subject.size() <= 160 &&
        request.resource.data.message is string && request.resource.data.message.size() >= 5 &&
        request.resource.data.message.size() <= 4096 &&
        request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow read, list, update, delete: if isAdmin();
    }

    // Site settings & tool configurations
    match /settings/{settingId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin identities
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
